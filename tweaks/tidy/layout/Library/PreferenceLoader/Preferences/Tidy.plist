<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>entry</key>
	<dict>
		<key>cell</key><string>PSLinkCell</string>
		<key>label</key><string>Tidy</string>
		<key>icon</key><string>Tidy.png</string>
	</dict>
	<key>title</key><string>Tidy</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>A cleaner home screen. Changes show right away.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>dev.cellblock.tidy</string>
			<key>key</key><string>enabled</string>
			<key>label</key><string>Enabled</string>
			<key>PostNotification</key><string>dev.cellblock.tidy/changed</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Hide</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>dev.cellblock.tidy</string>
			<key>key</key><string>hideLabels</string>
			<key>label</key><string>Icon Labels</string>
			<key>PostNotification</key><string>dev.cellblock.tidy/changed</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>dev.cellblock.tidy</string>
			<key>key</key><string>hideDots</string>
			<key>label</key><string>Page Dots</string>
			<key>PostNotification</key><string>dev.cellblock.tidy/changed</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>dev.cellblock.tidy</string>
			<key>key</key><string>hideDock</string>
			<key>label</key><string>Dock Background</string>
			<key>PostNotification</key><string>dev.cellblock.tidy/changed</string>
		</dict>
	</array>
</dict>
</plist>
